{
  // Separate from the "Ask Sergey AI" Worker (worker/). Do not reuse its name, KV or secrets.
  "name": "safe-return-feedback",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create SAFE_RETURN_FEEDBACK  -> paste the id below
    { "binding": "FEEDBACK", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://www.alexeev.pw",
    "RETENTION_DAYS": "365",
    "RATE_LIMIT_PER_HOUR": "5"
  }
  // Secrets (never in this file), all required outside local DEV: ADMIN_TOKEN, RATE_SALT, TURNSTILE_SECRET
  // Also set var TURNSTILE_HOSTNAME to "www.alexeev.pw". Recommended burst limiter (per minute, in addition to the KV hourly counter):
  //   "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }]
  //   npx wrangler secret put ADMIN_TOKEN
}
